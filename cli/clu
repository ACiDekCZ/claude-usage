#!/usr/bin/env python3
"""clu — print current Claude usage.

Prints the three figures that matter by default; --full for the detail.

Asks Claude Code for the plan limits with its `get_usage` control request,
which reports them straight from the server in a second or two, and adds the
pacing figure: where an even spread across the week would have you right now.
An older Claude Code that doesn't know the request is asked `claude -p /usage`,
which also reads every conversation kept on the computer and takes longer.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import uuid
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

DAILY_RATION = 100.0 / 7.0  # a day's share of the weekly limit

SESSION_RE = re.compile(r"^Current session:\s*(\d+)%\s*used(?:\s*·\s*resets\s*(.+))?$")
WEEK_RE = re.compile(r"^Current week \(([^)]+)\):\s*(\d+)%\s*used(?:\s*·\s*resets\s*(.+))?$")
# "Aug 12 at 1:59pm (Europe/Prague)" — minutes are dropped on the hour ("11am").
RESET_RE = re.compile(
    r"^(\w{3})\s+(\d{1,2})\s+at\s+(\d{1,2})(?::(\d{2}))?\s*(am|pm)\s*\(([^)]+)\)$",
    re.IGNORECASE)


class Colour:
    def __init__(self, enabled):
        self.enabled = enabled

    def __call__(self, text, code):
        return f"\033[{code}m{text}\033[0m" if self.enabled else text

    def dim(self, t):
        return self(t, "2")

    def bold(self, t):
        return self(t, "1")

    def green(self, t):
        return self(t, "32")

    def orange(self, t):
        return self(t, "33")

    def red(self, t):
        return self(t, "31")


class Unsupported(Exception):
    """Claude Code answered get_usage with an error: too old to know it."""


def run_get_usage(timeout):
    """The `get_usage` answer (a dict), or None when it had no plan limits.
    Raises Unsupported for a Claude Code that doesn't know the request."""
    request_id = f"clu-{uuid.uuid4()}"
    request = {"type": "control_request", "request_id": request_id,
               "request": {"subtype": "get_usage", "skip_behaviors": True}}
    try:
        proc = subprocess.run(
            ["claude", "-p", "--input-format", "stream-json",
             "--output-format", "stream-json", "--verbose"],
            input=json.dumps(request) + "\n",
            capture_output=True, text=True, timeout=timeout,
        )
    except FileNotFoundError:
        sys.exit("clu: `claude` not found on PATH")
    except subprocess.TimeoutExpired:
        sys.exit(f"clu: claude didn't answer within {timeout}s")
    for raw in proc.stdout.splitlines():
        if request_id not in raw:
            continue
        try:
            line = json.loads(raw)
        except ValueError:
            continue
        res = line.get("response") or {}
        if line.get("type") != "control_response" or res.get("request_id") != request_id:
            continue
        if res.get("subtype") != "success":
            raise Unsupported(res.get("error") or "get_usage failed")
        answer = res.get("response") or {}
        if answer.get("rate_limits_available") is not True or not answer.get("rate_limits"):
            return None
        return answer
    raise Unsupported(f"no answer to get_usage (exit {proc.returncode})")


def parse_iso(text):
    if not text:
        return None
    try:
        # "2026-11-25T12:00:00.073795+00:00" — fromisoformat takes it from 3.11;
        # dropping the fraction keeps 3.9 happy.
        return datetime.fromisoformat(re.sub(r"\.\d+", "", text)).astimezone()
    except ValueError:
        return None


def from_get_usage(answer):
    """The same shape parse() gives, from the get_usage answer."""
    rates = answer["rate_limits"]
    data = {"session": None, "limits": [], "raw": json.dumps(answer, indent=2)}

    def item(name, window, used_key="utilization"):
        reset = parse_iso(window.get("resets_at"))
        return {"name": name, "percent": round(window[used_key]), "reset": reset,
                "reset_text": reset.strftime("%a %-d %b, %H:%M") if reset else None}

    session = rates.get("five_hour")
    if session and session.get("utilization") is not None:
        data["session"] = item("session", session)
        del data["session"]["name"]
    week = rates.get("seven_day")
    if week and week.get("utilization") is not None:
        data["limits"].append(item("all models", week))
    for model in rates.get("model_scoped") or []:
        if model.get("utilization") is not None:
            data["limits"].append(item(model.get("display_name") or "model", model))
    return data


def run_claude(timeout):
    """Return the raw text of `claude -p /usage`."""
    try:
        proc = subprocess.run(
            ["claude", "-p", "/usage"],
            capture_output=True, text=True, timeout=timeout,
        )
    except FileNotFoundError:
        sys.exit("clu: `claude` not found on PATH")
    except subprocess.TimeoutExpired:
        sys.exit(f"clu: `claude -p /usage` timed out after {timeout}s")
    if proc.returncode != 0:
        sys.exit(f"clu: `claude -p /usage` failed ({proc.returncode})\n{proc.stderr.strip()}")
    return proc.stdout


def parse_reset(text, now):
    """'Aug 12 at 1:59pm (Europe/Prague)' -> aware datetime, or None."""
    if not text:
        return None
    m = RESET_RE.match(text.strip())
    if not m:
        return None
    month, day, hour, minute, ampm, tzname = m.groups()
    minute = int(minute or 0)
    hour = int(hour) % 12 + (12 if ampm.lower() == "pm" else 0)
    try:
        tz = ZoneInfo(tzname)
        month_num = datetime.strptime(month, "%b").month
    except (KeyError, ValueError):
        return None

    ref = now.astimezone(tz)
    for year in (ref.year, ref.year + 1, ref.year - 1):
        try:
            dt = datetime(year, month_num, int(day), hour, minute, tzinfo=tz)
        except ValueError:
            continue
        # Resets are always ahead of now, but allow a little slack for clock skew.
        if dt > ref - timedelta(days=1):
            return dt
    return None


def parse(text, now):
    data = {"session": None, "limits": [], "raw": text}
    for line in text.splitlines():
        line = line.strip()
        m = SESSION_RE.match(line)
        if m:
            data["session"] = {
                "percent": int(m.group(1)),
                "reset": parse_reset(m.group(2), now),
                "reset_text": (m.group(2) or "").strip() or None,
            }
            continue
        m = WEEK_RE.match(line)
        if m:
            data["limits"].append({
                "name": m.group(1),
                "percent": int(m.group(2)),
                "reset": parse_reset(m.group(3), now),
                "reset_text": (m.group(3) or "").strip() or None,
            })
    return data


def compact_duration(delta):
    total = max(0, int(delta.total_seconds()))
    days, rem = divmod(total, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"


def pace(week, now):
    """Where an even spread would have you, and how far off you are."""
    if not week or not week["reset"]:
        return None
    reset = week["reset"]
    start = reset - timedelta(days=7)
    elapsed = (now.astimezone(reset.tzinfo) - start).total_seconds() / (7 * 86400)
    elapsed = min(1.0, max(0.0, elapsed)) * 100
    return {"expected": elapsed, "ahead": week["percent"] - elapsed}


def colour_for_ahead(ahead, c):
    """Same rule as the menu bar app: red past +3, orange anywhere ahead,
    green once a full day's ration or more behind."""
    if ahead > 3:
        return c.red
    if ahead > 0:
        return c.orange
    if ahead < -DAILY_RATION:
        return c.green
    return lambda t: t


def colour_for_usage(percent, c):
    if percent >= 95:
        return c.red
    if percent >= 90:
        return c.orange
    return lambda t: t


def bar(percent, width, c):
    filled = max(0, min(width, round(percent / 100 * width)))
    return c.dim("█" * filled + "·" * (width - filled))


def render_short(data, now, c):
    """Three lines: what you've used, where you should be, and the session."""
    week = next((l for l in data["limits"] if "all models" in l["name"].lower()), None)
    if not week:
        sys.exit("clu: no weekly limit in claude's output")

    lines = [colour_for_usage(week["percent"], c)(f"{week['percent']}% used")]

    p = pace(week, now)
    if p:
        lines.append(colour_for_ahead(p["ahead"], c)(
            f"{round(p['expected'])}% of week gone"))

    # Appended last on purpose: anything reading the first two lines by
    # position keeps working.
    session = data.get("session")
    if session:
        line = colour_for_usage(session["percent"], c)(
            f"{session['percent']}% of session used")
        if session["reset"]:
            left = compact_duration(
                session["reset"] - now.astimezone(session["reset"].tzinfo))
            line += c.dim(f" · resets in {left}")
        lines.append(line)

    return "\n".join(lines)


def render_full(data, now, c):
    lines = []
    week = next((l for l in data["limits"] if "all models" in l["name"].lower()), None)

    rows = []
    if data["session"]:
        rows.append(("Session", data["session"]))
    for limit in data["limits"]:
        label = "Week" if limit is week else limit["name"]
        rows.append((label, limit))

    width = max((len(r[0]) for r in rows), default = 0)
    for label, item in rows:
        pct = item["percent"]
        cell = colour_for_usage(pct, c)(f"{pct:3d}%")
        line = f"{label.ljust(width)}  {cell}  {bar(pct, 16, c)}"
        if item["reset"]:
            left = compact_duration(item["reset"] - now.astimezone(item["reset"].tzinfo))
            stamp = item["reset"].strftime("%a %-d %b, %H:%M")
            line += "  " + c.dim(f"resets in {left}  ({stamp})")
        lines.append(line)

    p = pace(week, now)
    if p:
        tint = colour_for_ahead(p["ahead"], c)
        verdict = (f"{p['ahead']:.1f}% ahead of the line" if p["ahead"] > 0
                   else f"{abs(p['ahead']):.1f}% behind the line")
        expected = tint(f"{p['expected']:.1f}%")
        lines.append("")
        lines.append(f"{'Pace'.ljust(width)}  {week['percent']:3d}% used vs {expected} "
                     f"of the week gone  {tint(verdict)}")
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser(
        prog="clu", description="Print current Claude usage.")
    ap.add_argument("--full", "--long", action="store_true", dest="full",
                    help="every limit, with bars, reset times and the pace line")
    ap.add_argument("--raw", action="store_true",
                    help="print Claude Code's answer unchanged")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--timeout", type=int, default=60,
                    help="seconds to wait for claude (default 60)")
    args = ap.parse_args()

    now = datetime.now().astimezone()
    try:
        answer = run_get_usage(args.timeout)
    except Unsupported:
        answer = False
    if answer is None:
        sys.exit("clu: no plan limits — is Claude Code signed in to a Claude plan?")

    if answer:
        data = from_get_usage(answer)
        if args.raw:
            print(data["raw"])
            return
    else:
        text = run_claude(args.timeout)
        if args.raw:
            sys.stdout.write(text)
            return
        data = parse(text, now)
    if data["session"] is None and not data["limits"]:
        sys.stderr.write("clu: could not find usage figures in claude's output\n")
        sys.stdout.write(data["raw"])
        sys.exit(1)

    if args.json:
        week = next((l for l in data["limits"] if "all models" in l["name"].lower()), None)
        p = pace(week, now)
        out = {
            "session": _jsonable(data["session"]),
            "limits": [_jsonable(l) for l in data["limits"]],
            "pace": p,
        }
        print(json.dumps(out, indent=2))
        return

    c = Colour(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))
    print(render_full(data, now, c) if args.full else render_short(data, now, c))


def _jsonable(item):
    if item is None:
        return None
    out = dict(item)
    out["reset"] = item["reset"].isoformat() if item["reset"] else None
    return out


if __name__ == "__main__":
    main()
